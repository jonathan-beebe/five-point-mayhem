local byId: { [string]: Weapon } = {}
for _, weapon in WEAPONS do
	assert(byId[weapon.id] == nil, "Duplicate weapon id " .. weapon.id)
	byId[weapon.id] = weapon
end

local WeaponCatalog = {
	CATEGORIES = CATEGORIES,
	ALL = WEAPONS,
}

function WeaponCatalog.get(id: string): Weapon?
	return byId[id]
end

-- Finds a weapon by id or by a case-insensitive prefix of its name or id (for chat commands).
function WeaponCatalog.find(query: string): Weapon?
	local lowered = string.lower(query)
	if byId[lowered] then
		return byId[lowered]
	end
	for _, weapon in WEAPONS do
		local name = string.lower(weapon.name)
		if
			string.sub(name, 1, #lowered) == lowered
			or string.sub(weapon.id, 1, #lowered) == lowered
		then
			return weapon
		end
	end
	return nil
end

return WeaponCatalog
