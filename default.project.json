{
  "name": "mayhem",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 4
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2.5,
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "Gravity": 196.2
      }
    }
  }
}
